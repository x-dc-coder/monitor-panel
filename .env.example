# ===== monitor-panel 配置模板（issue #1：单一权威源）=====
#
# 加载顺序（app/config.py）：
#   已存在的环境变量（systemd/测试注入）
#   > MONITOR_ENV_FILE 显式路径
#   > /opt/monitor-panel/env（生产权威源，systemd EnvironmentFile 同一文件）
#   > 仓库根 .env（本地开发回退）
#
# - 生产：只需维护 /opt/monitor-panel/env（chmod 600），release 内不再有 .env 副本
# - 本地开发：复制本文件为 .env 后按需填写（默认 mock 全通）
# - live 模式启动校验必需项（缺失拒启）：MONITOR_FRPS_PASS / MONITOR_LEGACY_TOKEN
# - 完整变量参考即本文件（与 app/config.py 一一对应，分组相同）

# ---- 服务 ----
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8898
# 数据模式：1=mock（本地开发默认）| 0=live 真实采集 | snapshot=读 snapshots/ 快照
MONITOR_MOCK=1
MONITOR_DEBUG=0

# ---- 监控节点（多云预留） ----
# MONITOR_NODE_ID=cloud-1
# MONITOR_NODES=[{"id":"cloud-1","name":"cloud-1","role":"primary","public_ip":"124.221.190.237","enabled":true}]

# ---- 数据源（敏感项一律 env 注入，不硬编码；live 模式必需标 ★）----
# frps dashboard（127.0.0.1:7500，basic auth）
MONITOR_FRPS_URL=http://127.0.0.1:7500
MONITOR_FRPS_USER=admin
MONITOR_FRPS_PASS=                # ★ live 必需（取自 /etc/frp/frps.toml）
# MONITOR_FRPS_TIMEOUT=5.0

# 既有 8899 frp 面板（只读消费 /api/status）
MONITOR_LEGACY_STATUS_URL=http://127.0.0.1:8899/api/status
MONITOR_LEGACY_TOKEN=             # ★ live 必需（8899 API_TOKEN）

# headscale 控制面
MONITOR_HEADSCALE_METRICS_URL=http://127.0.0.1:9090/metrics
MONITOR_HEADSCALE_TCP_HOST=127.0.0.1
MONITOR_HEADSCALE_TCP_PORT=8080
# MONITOR_HEADSCALE_DERP_REGION=999

# 证书扫描（/etc/letsencrypt/live 目录 700，经 sudoers 白名单 openssl 读取）
MONITOR_CERT_DOMAINS=["dc-sy.cn","headscale.dc-sy.cn","monitor.dc-sy.cn"]
# MONITOR_LETSENCRYPT_LIVE=/etc/letsencrypt/live

# 探测对（cloud-2 接入后补对等探测，见 docs/04 §2.2；勿用占位 IP——每轮必超时拖慢采集）
MONITOR_PROBES=[{"name":"ali-dns","kind":"icmp","target":"223.5.5.5"},{"name":"cloudflare-dns","kind":"icmp","target":"1.1.1.1"},{"name":"public-https","kind":"http","target":"https://example.com"},{"name":"dns-resolve","kind":"dns","target":"example.com"}]

# tailscale HostName ↔ 8899 device_id 对照（可选，缺失不阻塞）
MONITOR_DEVICE_MAP={"vm-0-12-ubuntu":"cloud-server","dc-desktop":"desktop","oppo-pad-mini":"laptop"}

# ---- Release 监控（issue #4：只读聚合 github-release-monitor）----
# MONITOR_GRM_DATA_PATH=/opt/github-release-monitor/data/repositories.json
# MONITOR_GRM_BASE_URL=https://releases.monitor.dc-sy.cn
# MONITOR_INTERVAL_GRM=300

# ---- 服务台账（issue #2：端口约定驱动自动发现，见 docs/05）----
# 约定区：自定义项目/网站统一绑定该区间，面板自动扫描发现+探活
MONITOR_SERVICES_PORT_RANGE=[10000,19999]
# 人工覆盖名：{"ip:port": "显示名"}
# MONITOR_SERVICES_ALIASES={"100.64.0.2:10010":"摄像头"}
# 约定区外必探端口（按设备 IP，自动发现+探活，如 22/80/443/8898 等固定端口）：
# MONITOR_SERVICES_EXTRA_PORTS={"100.64.0.1":[22,443,8898,8901],"100.64.0.2":[3080,13080]}
# 按域名探测（nginx 虚拟主机按 Host 路由，IP 探测会 404；https=True 走 TLS 不校验证书）：
# MONITOR_SERVICES_EXTRA_PORTS={"100.64.0.1":{"80":{"host":"monitor.dc-sy.cn"},"443":{"host":"monitor.dc-sy.cn","https":true},"9090":{"path":"/metrics"}}}
# 服务公网直达地址（前端直达列用）：{"ip:port": "https://..."}
# MONITOR_SERVICES_PUBLIC_URLS={"100.64.0.1:8898":"https://monitor.dc-sy.cn"}
# MONITOR_SERVICES_SCAN_BATCH=256          # 每轮每设备扫描端口数（分片轮巡）
# MONITOR_SERVICES_CONNECT_TIMEOUT=1.5     # TCP 连接超时（秒）
# MONITOR_SERVICES_HTTP_TIMEOUT=2.0        # HTTP 识别超时（秒）
# MONITOR_SERVICES_CONCURRENCY=64          # 扫描并发上限
# MONITOR_SERVICES_MISSING_ROUNDS=3        # 连续 N 轮未开放 → closed
# ---- 行生命周期与告警降噪（2026-08-24 审查：误报治理） ----
# MONITOR_SERVICES_PRUNE_CLOSED_S=3600     # closed 持续超时后行删除+告警 resolve（残留/ephemeral）
# MONITOR_SERVICES_ALERT_MIN_AGE_S=600     # 首见不足该秒数即下线 → 不告警（临时端口）

# ---- 采集周期（秒） ----
# MONITOR_INTERVAL_FRP=30
# MONITOR_INTERVAL_TAILSCALE=30
# MONITOR_INTERVAL_TS_PING=60
# MONITOR_INTERVAL_HEADSCALE=30
# MONITOR_INTERVAL_SYSTEM=30
# MONITOR_INTERVAL_NETWORK=60
# MONITOR_INTERVAL_CERTS=3600
# MONITOR_INTERVAL_SERVICES=60

# ---- tailscale ping 语义 ----
# MONITOR_PING_PACKETS=3
# MONITOR_PING_TIMEOUT=8.0
# MONITOR_PING_CONCURRENCY=2
# MONITOR_PING_DEBOUNCE_ROUNDS=3
# MONITOR_MANUAL_PING_RATELIMIT_S=5.0
# MONITOR_STEP_TIMEOUT=10.0

# ---- 阈值 ----
# MONITOR_THRESHOLD_TS_LATENCY_WARN=200
# MONITOR_THRESHOLD_TS_LATENCY_CRIT=500
# MONITOR_THRESHOLD_PACKET_LOSS_WARN=2
# MONITOR_THRESHOLD_PACKET_LOSS_CRIT=5
# MONITOR_THRESHOLD_CERT_WARN_DAYS=30
# MONITOR_THRESHOLD_CERT_CRIT_DAYS=7
# MONITOR_THRESHOLD_DISK_WARN=85
# MONITOR_THRESHOLD_DISK_CRIT=92
# MONITOR_ALERT_COOLDOWN_S=1800
# MONITOR_NETWORK_PROBE_ALERT=0

# ---- 数据库 ----
# 生产固定（deploy.sh/systemd ReadWritePaths 同一路径，勿随 release 分叉）：
# MONITOR_DB_PATH=/opt/monitor-panel/data/monitor.db
# 本地开发默认 ./data/monitor.db，留空即可
# MONITOR_SAMPLE_RETENTION_DAYS=30
# MONITOR_ALERT_RETENTION_DAYS=90
# MONITOR_CLEANUP_INTERVAL_S=3600

# ---- 命令（真实模式默认经 sudoers 白名单 sudo -n）----
# MONITOR_SUDO=1
# MONITOR_TAILSCALE_CMD=tailscale
# MONITOR_HEADSCALE_CMD=headscale
# MONITOR_PING_CMD=ping

# ---- ingest（issue #5：远端 agent 上报，nginx 已豁免 Basic Auth，应用层 Bearer token 防护）----
# cloud-2 接入时启用：nginx location /api/ingest 已 auth_basic off，防护全在此 token
# 启用（MONITOR_INGEST_ENABLED=1）时 token 必填，缺失将拒绝启动
# MONITOR_INGEST_ENABLED=0
# MONITOR_INGEST_TOKEN=            # 启用时必需（建议 ≥24 字符）

# ---- SSO（Casdoor OIDC；启用时 live 模式会话密钥必填）----
# MONITOR_SSO_ENABLED=1
# CASDOOR_CLIENT_ID=
# CASDOOR_CLIENT_SECRET=
# CASDOOR_ISSUER=https://sso.dc-sy.cn
# 会话 cookie 签名密钥：≥32 随机字符，可用 `openssl rand -hex 32` 生成
# live + SSO 启用时留空/使用默认值将拒绝启动（可伪造会话 cookie）
MONITOR_SESSION_SECRET=

# ===== monitor-panel 配置模板 =====
# 复制为 .env 后填写（.env 不入 git，权限 chmod 600）
# 云端实际部署时由部署流程注入，或置于 /opt/monitor-panel/current/.env

# ---- 服务 ----
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8898
# 本地开发默认 true；cloud 部署必须 MONITOR_MOCK=0
MONITOR_MOCK=1
MONITOR_DEBUG=0

# ---- 数据源（敏感项一律 env 注入，不硬编码）----
# frps dashboard（127.0.0.1:7500，basic auth）
MONITOR_FRPS_URL=http://127.0.0.1:7500
MONITOR_FRPS_USER=admin
MONITOR_FRPS_PASS=

# 既有 8899 frp 面板（只读消费 /api/status）
MONITOR_LEGACY_STATUS_URL=http://127.0.0.1:8899/api/status
MONITOR_LEGACY_TOKEN=

# headscale 控制面
MONITOR_HEADSCALE_METRICS_URL=http://127.0.0.1:9090/metrics
MONITOR_HEADSCALE_TCP_HOST=127.0.0.1
MONITOR_HEADSCALE_TCP_PORT=8080

# 证书扫描域名清单（对应 /etc/letsencrypt/live/<domain>/cert.pem）
MONITOR_CERT_DOMAINS=["dc-sy.cn","headscale.dc-sy.cn","monitor.dc-sy.cn"]

# 探测对（多云兜底雏形；cloud2 接入后补对等探测）
MONITOR_PROBES=[{"name":"ali-dns","kind":"icmp","target":"223.5.5.5"},{"name":"cloudflare-dns","kind":"icmp","target":"1.1.1.1"},{"name":"public-https","kind":"http","target":"https://example.com"},{"name":"dns-resolve","kind":"dns","target":"example.com"},{"name":"cloud2-443","kind":"tcp","target":"2.2.2.2","port":443}]

# tailscale HostName ↔ 8899 device_id 对照（可选，缺失不阻塞）
MONITOR_DEVICE_MAP={"vm-0-12-ubuntu":"cloud-server","dc-desktop":"desktop","oppo-pad-mini":"laptop"}

# ---- 服务台账（issue #2：端口约定驱动自动发现，见 docs/05）----
# 约定区：自定义项目/网站统一绑定该区间，面板自动扫描发现+探活
MONITOR_SERVICES_PORT_RANGE=[10000,19999]
# 人工覆盖名：{"ip:port": "显示名"}
# MONITOR_SERVICES_ALIASES={"100.64.0.2:10010":"摄像头"}
# 约定区外必探端口（按设备 IP，自动发现+探活，如 22/80/443/8898 等固定端口）：
# MONITOR_SERVICES_EXTRA_PORTS={"100.64.0.1":[22,443,8898,8901],"100.64.0.2":[3080,13080]}
# 按域名探测（nginx 虚拟主机按 Host 路由，IP 探测会 404；https=True 走 TLS 不校验证书）：
# MONITOR_SERVICES_EXTRA_PORTS={"100.64.0.1":{"80":{"host":"monitor.dc-sy.cn"},"443":{"host":"monitor.dc-sy.cn","https":true},"9090":{"path":"/metrics"}}}
# MONITOR_SERVICES_SCAN_BATCH=256          # 每轮每设备扫描端口数（分片轮巡）
# MONITOR_SERVICES_CONNECT_TIMEOUT=1.5     # TCP 连接超时（秒）
# MONITOR_SERVICES_HTTP_TIMEOUT=2.0        # HTTP 识别超时（秒）
# MONITOR_SERVICES_CONCURRENCY=64          # 扫描并发上限
# MONITOR_SERVICES_MISSING_ROUNDS=3        # 连续 N 轮未开放 → closed
# MONITOR_INTERVAL_SERVICES=60             # 扫描周期（秒）

# ---- 数据库 ----
# MONITOR_DB_PATH=./data/monitor.db

# ---- 命令（真实模式默认经 sudoers 白名单 sudo -n）----
# MONITOR_SUDO=1

# ---- ingest（二期启用；默认 404）----
# MONITOR_INGEST_ENABLED=0
# MONITOR_INGEST_TOKEN=

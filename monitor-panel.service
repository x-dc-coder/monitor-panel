[Unit]
Description=monitor.dc-sy.cn unified monitoring panel (127.0.0.1:8898)
After=network-online.target
Wants=network-online.target
# 防重启风暴（评审 C4/E15）——必须置于 [Unit] 段：放 [Service] 会被 systemd
# 忽略（2026-10-02 排查：unit 第 21 行报 Unknown key name 'StartLimitIntervalSec'）
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# 专用用户 monitor + sudoers 白名单（评审 C5：不复制 8899 的 root 运行模式）
User=monitor
Group=monitor
WorkingDirectory=/opt/monitor-panel/current
# .env 在 current 之外的固定路径（/opt/monitor-panel/env），避免 release 切换时丢失；
# 敏感项 env 注入 + 文件 600
EnvironmentFile=-/opt/monitor-panel/env
# --no-access-log（2026-08-24 审查）：access log 每请求一行写入 journal
# （前端 5s 轮询 + 自探测流量放大，8 天 528MB）；审计需求由 nginx access log 覆盖
ExecStart=/opt/monitor-panel/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8898 --no-access-log
Restart=on-failure
RestartSec=5
# 注意：不用 NoNewPrivileges —— 它阻止 setuid 提权，与"monitor 用户 +
# sudoers NOPASSWD 白名单"设计冲突（sudo -n 需要提权）。安全由 sudoers
# 白名单（deploy/sudoers.monitor）+ PrivateTmp + ReadWritePaths 承担。
PrivateTmp=true
# 只读进程加固（SQLite 写固定数据目录 /opt/monitor-panel/data，
# 避免 release 切换导致数据库分叉；日志走 journald）
ReadWritePaths=/opt/monitor-panel/data

[Install]
WantedBy=multi-user.target

[Unit]
Description=Daily SQLite backup for monitor-panel (WAL-safe .backup)
After=network.target

[Service]
Type=oneshot
# N3: 以 monitor 用户运行，与 db 属主一致（backups/ 可写、db 可读）
# 2026-08-24 修复：服务器无 sqlite3 CLI（曾每日 exit 127），改用 python3 标准库
# sqlite3.Connection.backup()（等价 WAL 安全的 .backup，系统自带零依赖）
# 2026-10-20：ExecStart 指向 current/deploy/backup-db.sh——随 release 符号链接
# 自动更新，无需额外部署步骤（脚本内全绝对路径，可从任意 CWD 运行）
User=monitor
Group=monitor
WorkingDirectory=/opt/monitor-panel
ExecStart=/usr/bin/bash /opt/monitor-panel/current/deploy/backup-db.sh

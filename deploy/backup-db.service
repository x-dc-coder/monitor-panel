[Unit]
Description=Daily SQLite backup for monitor-panel (WAL-safe .backup)
After=network.target

[Service]
Type=oneshot
# N3: 以 monitor 用户运行，与 db 属主一致（backups/ 可写、db 可读）
User=monitor
Group=monitor
WorkingDirectory=/opt/monitor-panel
ExecStart=/usr/bin/bash -c 'mkdir -p /opt/monitor-panel/backups && /usr/bin/sqlite3 /opt/monitor-panel/current/data/monitor.db ".backup /opt/monitor-panel/backups/monitor-$(date +%%F).db" && /usr/bin/find /opt/monitor-panel/backups -maxdepth 1 -name "monitor-*.db" -mtime +14 -delete'

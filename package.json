{
  "name": "monitor-panel-web",
  "version": "0.1.0",
  "private": true,
  "description": "monitor.dc-sy.cn 统一监控面板前端（TypeScript + esbuild）",
  "scripts": {
    "build": "esbuild web/src/main.ts --bundle --outfile=web/dist/app.js --minify",
    "build:dev": "esbuild web/src/main.ts --bundle --outfile=web/dist/app.js --sourcemap",
    "watch": "esbuild web/src/main.ts --bundle --outfile=web/dist/app.js --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
